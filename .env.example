# Groq (required for answer generation) - get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Chunking (characters). ~1000 chars ≈ 180-220 words, which fits the embedding model's 256-token window.
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# Retrieval
TOP_K=5
MIN_SIMILARITY=0.25

# Upload limit in megabytes
MAX_UPLOAD_MB=50

# Local embedding model (runs on CPU via ONNX, no API calls)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: folder containing a pre-downloaded ONNX export of the model (offline use)
EMBEDDING_MODEL_PATH=
